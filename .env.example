# Load explicitly with node --env-file=/absolute/path/.env dist/index.js
AZDO_PAT=
# Or AZDO_BEARER_TOKEN (exactly one credential). Inject via secret manager in production.
# AZDO_BEARER_TOKEN=
AZDO_ORGANIZATION=example-org
AZDO_PROJECT=Example Project
# Optional organization allowlist, comma-separated. Empty allows any organization.
AZDO_ALLOWED_ORGANIZATIONS=example-org
AZDO_TIMEOUT_MS=15000
AZDO_MAX_RETRIES=2
AZDO_LOG_LEVEL=error

# Optional recurring operations. Use absolute paths in production.
# AZDO_OPERATIONS_FILE=C:/absolute/path/mcp-azure-devops/operations.local.yaml
# AZDO_STATE_DIR=C:/Users/YOUR_USER/AppData/Local/azure-devops-classic-mcp/state
AZDO_ENABLE_WRITES=false
AZDO_ENABLE_APPROVALS=false

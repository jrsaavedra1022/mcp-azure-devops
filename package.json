{
  "name": "azure-devops-classic-mcp",
  "version": "0.2.0",
  "description": "Azure DevOps Classic Releases MCP with reviewed recurring operations",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "bin": {
    "azure-devops-classic-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepack": "npm run check",
    "demo": "node --import tsx src/operations/demo.ts",
    "catalog:validate": "node --import tsx src/operations/validate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "eslint": "^10.11.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.0.0"
  }
}
